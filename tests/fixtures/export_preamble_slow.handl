-- Slow export-declaring module: like `preamble_slow.handl` but with
-- `export` declarations — the runner must still evaluate the preamble
-- once per module per worker, not once per test. `helper` is an arrow
-- binding so the test also covers function injection through the env.

burn := n ~> {
  while { i: n, acc: 0 } {
    (st) ~> if st.i <= 0 {
      { out: st.acc }
    } else {
      { state: { i: st.i - 1, acc: st.acc + st.i } }
    }
  }
}

slow_total := burn(30000)
helper := (x) ~> x + slow_total
export slow_total, helper

test_slow_a := slow_total == 450015000
test_slow_b := helper(0) == 450015000
test_slow_c := slow_total + 1 == 450015001
